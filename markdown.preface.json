,"column":1},"end":{"line":33,"column":1}},"key":"PudmOpYhfm"},{"type":"link","kind":"ref","identifier":"lob_models","label":"lob_models","url":"/markdown/lob-models","internal":true,"dataUrl":"/markdown.lob-models.json","children":[{"type":"text","value":"Modelling the Limit Order Book","key":"VmCLcHMywE"}],"key":"YEkwNwCNlU"},{"type":"text","value":", ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"BKjz7QLJXw"},{"type":"link","kind":"ref","identifier":"optimal_execution","label":"optimal_execution","url":"/markdown/optimal-execution","internal":true,"dataUrl":"/markdown.optimal-execution.json","children":[{"type":"text","value":"Optimal Execution Theory","key":"Ma63kFJDTZ"}],"key":"f1JK0gr9XF"},{"type":"text","value":", ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"yGJupLdR0t"},{"type":"link","kind":"ref","identifier":"execution_tactics","label":"execution_tactics","url":"/markdown/execution-tactics","internal":true,"dataUrl":"/markdown.execution-tactics.json","children":[{"type":"text","value":"Execution Tactics","key":"GxyfX8Z5ce"}],"key":"iP4nqQYLXX"},{"type":"text","value":") covers the problem of executing a pre-determined order in the market at minimum cost and risk. It begins with the taxonomy of execution benchmarks and cost models, develops models of the limit order book and order flow, derives the Almgren–Chriss optimal execution trajectory, and covers practical execution tactics including adaptive slicing and dark-pool routing.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"XbSfjM0jls"}],"key":"b1aAIiNqj3"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"strong","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Part IV — Market Making Algorithms","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"GTtaZPdTlO"}],"key":"NFB7RGO5UZ"},{"type":"text","value":" (","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"WyDtACYhLK"},{"type":"link","kind":"ref","identifier":"market_making_fundamentals","label":"market_making_fundamentals","url":"/markdown/market-making-fundamentals","internal":true,"dataUrl":"/markdown.market-making-fundamentals.json","children":[{"type":"text","value":"Market Making Fundamentals","key":"Na9Uqj7wf7"}],"key":"f64R6CTzKZ"},{"type":"text","value":", ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"vP0VYktS7U"},{"type":"link","kind":"ref","identifier":"fair_price_estimation","label":"fair_price_estimation","url":"/markdown/fair-price-estimation","internal":true,"dataUrl":"/markdown.fair-price-estimation.json","children":[{"type":"text","value":"Fair value estimation","key":"KEANBY5x2k"}],"key":"iFp8V4qdHt"},{"type":"text","value":", ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"X2IkVySGZD"},{"type":"link","kind":"ref","identifier":"liquidity_modelling","label":"liquidity_modelling","url":"/markdown/liquidity-modelling","internal":true,"dataUrl":"/markdown.liquidity-modelling.json","children":[{"type":"text","value":"Liquidity Modelling","key":"Fsu99u5b1r"}],"key":"ZjloMSFmEm"},{"type":"text","value":", ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"NDkEqmYjnO"},{"type":"link","kind":"ref","identifier":"rfq_models","label":"rfq_models","url":"/markdown/rfq-models","internal":true,"dataUrl":"/markdown.rfq-models.json","children":[{"type":"text","value":"Modelling RfQs in Dealer to Client Markets","key":"vOcdk40hQW"}],"key":"bxNnhiIm2V"},{"type":"text","value":", ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"WDoO8Lyo3D"},{"type":"link","kind":"ref","identifier":"optimal_market_making","label":"optimal_market_making","url":"/markdown/optimal-market-making","internal":true,"dataUrl":"