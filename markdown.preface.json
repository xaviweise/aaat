rue,"dataUrl":"/markdown.data-driven-methods.json","children":[{"type":"text","value":"Data-Driven Methods","key":"cYD1yYbIT8"}],"key":"SRAlg7AxMf"},{"type":"text","value":" provides useful context for ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"hTVyQk1IwQ"},{"type":"link","kind":"ref","identifier":"generative_ai","label":"generative_ai","url":"/markdown/generative-ai","internal":true,"dataUrl":"/markdown.generative-ai.json","children":[{"type":"text","value":"Generative Artificial Intelligence","key":"GuHCv9IZyb"}],"key":"HJJVwErJzH"},{"type":"text","value":".","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"W8YWdEtndE"}],"key":"mPPkWk48H2"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"strong","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Part III — Advanced Analytics for Financial Markets","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"vMqNYrMNrY"}],"key":"gfG2EJ6vVK"},{"type":"text","value":" (","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"nS5cZTx0Sf"},{"type":"link","kind":"ref","identifier":"market_microstructure","label":"market_microstructure","url":"/markdown/market-microstructure","internal":true,"dataUrl":"/markdown.market-microstructure.json","children":[{"type":"text","value":"Market microstructure","key":"JmXx52IHqs"}],"key":"GkGAFaP049"},{"type":"text","value":", ","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"Dx0cD331rS"},{"type":"link","kind":"ref","identifier":"lob_models","label":"lob_models","url":"/markdown/lob-models","internal":true,"dataUrl":"/markdown.lob-models.json","children":[{"type":"text","value":"Modelling the Limit Order Book","key":"KTIFTKLi3C"}],"key":"wVSnLjayJb"},{"type":"text","value":", ","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"YLUFyQuq57"},{"type":"link","kind":"ref","identifier":"rfq_models","label":"rfq_models","url":"/markdown/rfq-models","internal":true,"dataUrl":"/markdown.rfq-models.json","children":[{"type":"text","value":"Modelling RfQs in Dealer to Client Markets","key":"MkP9oyUg1h"}],"key":"MH6lk7Ntvl"},{"type":"text","value":", ","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"UaXjR1iOX3"},{"type":"link","kind":"ref","identifier":"fair_price_estimation","label":"fair_price_estimation","url":"/markdown/fair-price-estimation","internal":true,"dataUrl":"/markdown.fair-price-estimation.json","children":[{"type":"text","value":"Fair value estimation","key":"odfKy6jYhq"}],"key":"ZqMmZ8US1J"},{"type":"text","value":", ","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"k3DOSVcf1A"},{"type":"link","kind":"ref","identifier":"liquidity_modelling","label":"liquidity_modelling","url":"/markdown/liquidity-modelling","internal":true,"dataUrl":"/markdown.liquidity-modelling.json","children":[{"type":"text","value":"Liquidity Modelling","key":"upXQkN8yQW"}],"key":"C7f2Q1X5Sf"},{"type":"text","value":") develops the quantitative models of financial markets that underpin the algorithmic chapters and stand on their own as a treatment of advanced financial analytics. It covers market microstructure and price formation theory, models of limit order book dynamics and order flow, request-for-quote market models, methods for fair price estimation (Kalman filters, Black–Scholes–Merton, utility indifference, stochastic discount factors), and the measurement and modelling of market liquidity. Readers interested in quantitative financial analysis — pricing, liquidity research, or risk modelling — can read Parts I through III as a self-contained introduction, independently of the algorithm-focused parts that follow.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"MU5kGqONFG"}],"key":"wmjMzfrMeZ"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"strong","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Part IV — Execution Algorithms","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"FkC3yDc4YO"}],"key":"Fuk2YG4nYF"},{"type":"text","value":" (","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"pqxEGIXK29"},{"type":"link","kind":"ref","identifier":"execution_fundamentals","label":"execution_fundamentals","url":"/markdown/execution-fundamentals","internal":true,"dataUrl":"/markdown.execution-fundamentals.json","children":[{"type":"text","value":"Execution fundamentals","key":"NHjEEOwfYq"}],"key":"f0gh43AGow"},{"type":"text","value":", ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"Cg9UV3b4UD"},{"type":"link","kind":"ref","identifier":"optimal_execution","label":"optimal_execution","url":"/markdown/optimal-execution","internal":true,"dataUrl":"/markdown.optimal-execution.json","children":[{"type":"text","value":"Optimal Execution Theory","key":"djuYuk1PgN"}],"key":"V6zHcGSgCr"},{"type":"text","value":", ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"yXJ1HPx3I8"},{"type":"link","kind":"ref","identifier":"execution_tactics","label":"execution_tactics","url":"/markdown/execution-tactics","internal":true,"dataUrl":"/markdown.execution-tactics.json","children":[{"type":"text","value":"Execution Tactics","key":"ec0SR3uybe"}],"key":"apVKL8UByY"},{"type":"text","value":") covers the problem of executing a pre-determined order in the market at minimum cost and risk. It develops the taxonomy of execution benchmarks and cost models, derives the Almgren–Chriss optimal execution trajectory, and covers practical execution tactics including adaptive slicing and dark-pool routing.","position":{"start":{"line